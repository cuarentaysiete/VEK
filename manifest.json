{
  "manifestVersion": 5,
  "id": "net.vektorshop.vectorscope",
  "name": "VektorShop Vectorscope",
  "main": "index.html",
  "version": "0.1.0",
  "requiredPhotoShopVersion": "23.0",
  "modal": false,
  "network": {
    "domains": ["never"]
  },
  "permissions": [
    "dom",
    "lob"
  ],
  "modules": {
    "photoshop": {
      "scopes": ["app", "action"]
    },
    "imaging": {}
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "vektorshop.vectorscope.panel",
      "label": {
        "default": "VektorShop Vectorscope"
      },
      "minimumSize": [320, 360],
      "maximumSize": [900, 1200],
      "preferredWidth": 420,
      "preferredHeight": 700
    }
  ]
}
