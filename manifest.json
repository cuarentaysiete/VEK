{
  "id": "net.vektorshop.vectorscope",
  "name": "VektorShop Vectorscope",
  "version": "0.3.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "23.3.0",
    "data": {
      "apiVersion": 2
    }
  },
  "manifestVersion": 5,
  "entrypoints": [
    {
      "type": "panel",
      "id": "vektorshop.panel",
      "label": {
        "default": "VektorShop Vectorscope"
      },
      "minimumSize": { "width": 320, "height": 360 },
      "maximumSize": { "width": 900, "height": 1200 },
      "preferredDockedSize": { "width": 420, "height": 700 },
      "preferredFloatingSize": { "width": 460, "height": 720 },
      "icons": [
        { "width": 23, "height": 23, "path": "icons/dark.png", "scale": [1, 2], "theme": ["darkest", "dark", "medium"] },
        { "width": 23, "height": 23, "path": "icons/light.png", "scale": [1, 2], "theme": ["lightest", "light"] }
      ]
    }
  ],
  "icons": [
    { "width": 23, "height": 23, "path": "icons/dark.png", "scale": [1, 2], "theme": ["darkest", "dark", "medium"] },
    { "width": 23, "height": 23, "path": "icons/light.png", "scale": [1, 2], "theme": ["lightest", "light"] }
  ]
}
