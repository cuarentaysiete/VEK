{
  "id": "net.vektorshop.vectorscope",
  "name": "VektorShop Vectorscope",
  "version": "0.3.2",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "23.3.0",
    "data": {
      "apiVersion": 2
    }
  },
  "manifestVersion": 5,
  "entrypoints": [
    {
      "type": "panel",
      "id": "vektorshop.panel",
      "label": {
        "default": "VektorShop Vectorscope"
      },
      "minimumSize": { "width": 320, "height": 360 },
      "maximumSize": { "width": 900, "height": 1200 },
      "preferredDockedSize": { "width": 420, "height": 700 },
      "preferredFloatingSize": { "width": 460, "height": 720 },
      "icons": [
        { "width": 23, "height": 23, "path": "icons/dark-1x.png", "scale": [1], "theme": ["darkest", "dark", "medium"] },
        { "width": 23, "height": 23, "path": "icons/dark-2x.png", "scale": [2], "theme": ["darkest", "dark", "medium"] },
        { "width": 23, "height": 23, "path": "icons/light-1x.png", "scale": [1], "theme": ["lightest", "light"] },
        { "width": 23, "height": 23, "path": "icons/light-2x.png", "scale": [2], "theme": ["lightest", "light"] }
      ]
    }
  ],
  "icons": [
    { "width": 32, "height": 32, "path": "icons/plugin-1x.png", "scale": [1], "theme": ["darkest", "dark", "medium"] },
    { "width": 32, "height": 32, "path": "icons/plugin-2x.png", "scale": [2], "theme": ["darkest", "dark", "medium"] },
    { "width": 32, "height": 32, "path": "icons/plugin-light-1x.png", "scale": [1], "theme": ["lightest", "light"] },
    { "width": 32, "height": 32, "path": "icons/plugin-light-2x.png", "scale": [2], "theme": ["lightest", "light"] }
  ]
}
